# Configuration IP - via GUI Packet Tracer
# Desktop > IP Configuration  (pour PC et Serveurs)
# Services > HTTP > ON        (pour Serveurs uniquement)

# Equipement  | IP Address    | Subnet Mask   | Gateway
# ------------|---------------|---------------|-------------
# Routeur     | 192.168.1.1   | 255.255.255.0 | -
# Serveur1    | 192.168.1.10  | 255.255.255.0 | 192.168.1.1
# Serveur2    | 192.168.1.11  | 255.255.255.0 | 192.168.1.1
# PC1         | 192.168.1.100 | 255.255.255.0 | 192.168.1.1
# PC2         | 192.168.1.101 | 255.255.255.0 | 192.168.1.1

# Page web Serveur1 : "Serveur distribue 1 actif"
# Page web Serveur2 : "Serveur distribue 2 actif"
